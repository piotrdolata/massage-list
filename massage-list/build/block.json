{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "massage-list/submenu-tiles",
  "version": "1.0.0",
  "title": "Massage List",
  "category": "design",
  "icon": "grid-view",
  "description": "Wyświetl elementy submenu jako kafelki.",
  "attributes": {
    "menuId": {
      "type": "number",
      "default": 0
    },
    "parentId": {
      "type": "number",
      "default": 0
    },
    "columnsDesktop": {
      "type": "number",
      "default": 3
    },
    "columnsTablet": {
      "type": "number",
      "default": 3
    },
    "columnsMobile": {
      "type": "number",
      "default": 2
    }
  },
  "supports": {
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true
    },
    "html": false
  },
  "textdomain": "massage-list",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}