{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "massage-list/submenu-tiles",
	"version": "1.0.0",
	"title": "Massage List",
	"category": "widgets",
	"icon": "grid-view",
	"description": "Wyświetla bezpośrednie elementy podrzędne wybranego elementu menu w formie responsywnych kafelków.",
	"keywords": [ "menu", "podmenu", "kafelki", "massage", "podstrony" ],
	"textdomain": "massage-list",
	"attributes": {
		"menuId": {
			"type": "number",
			"default": 0
		},
		"parentId": {
			"type": "number",
			"default": 0
		},
		"columnsDesktop": {
			"type": "number",
			"default": 3
		},
		"columnsTablet": {
			"type": "number",
			"default": 3
		},
		"columnsMobile": {
			"type": "number",
			"default": 2
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalDefaultControls": {
				"fontSize": true,
				"fontWeight": true
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
}